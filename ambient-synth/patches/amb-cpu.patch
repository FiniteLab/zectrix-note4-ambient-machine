+/* N150 optimization: identical table interpolation for a phase already reduced to one turn. */
+static inline float sine_unit(float ph)
+{
+    float x = ph * (float)SN;
+    int i = (int)x;
+    float f = x - (float)i;
+    return sint[i] + (sint[i + 1] - sint[i]) * f;
+}
