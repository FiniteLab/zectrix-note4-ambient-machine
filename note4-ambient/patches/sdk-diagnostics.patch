+fn diagnostic_gap(total: usize) -> Result<Option<(usize, usize)>> {
+    let Some(spec) = env::var_os("ZECTRIX_DIAG_GAP") else { return Ok(None) };
+    let spec = spec.into_string().map_err(|_| Error::InvalidOptions("ZECTRIX_DIAG_GAP 应为 ASCII 帧范围".into()))?;
+    let (start, count) = spec.split_once(':').ok_or_else(|| Error::InvalidOptions("ZECTRIX_DIAG_GAP 应为 <起始帧>:<帧数>".into()))?;
+    let start = start.parse::<usize>().map_err(|_| Error::InvalidOptions("断流起始帧无效".into()))?;
+    let count = count.parse::<usize>().map_err(|_| Error::InvalidOptions("断流帧数无效".into()))?;
+    if start >= total || count == 0 || count > total - start {
+        return Err(Error::InvalidOptions("断流范围超出当前音频".into()));
+    }
+    Ok(Some((start, start + count)))
+}
